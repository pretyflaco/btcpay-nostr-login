@model BTCPayServer.Plugins.NostrLogin.NostrLoginViewModel
@* NIP-07 browser-extension signer (keys.band, Alby, nos2x…) + the "is the QR needed?" decision.

   Relays are started server-side by the first status poll, and pages only poll once they show
   the QR. This partial decides when that is: if no extension shows up within ~0.8 s the QR is
   needed right away; if one does, the QR stays collapsed until the user picks "signer app".
   Pages wait for it via window.__nostrQrNeeded / the "nostr-qr-needed" event. *@
<div id="NostrExtension" hidden
     data-auth-url="@Model.ExtensionAuthUrl"
     data-challenge="@Model.ExtensionChallenge"
     data-prompt="@Model.ExtensionPrompt"
     data-return-url="@Model.ReturnUrl">
    @Html.AntiForgeryToken()
    <button type="button" class="btn btn-primary" id="NostrExtensionButton">@Model.ExtensionButtonLabel</button>
    <p class="text-muted mt-2 mb-0">
        <small>Uses your Nostr browser extension (NIP-07), such as keys.band, Alby or nos2x.</small>
    </p>
    <div class="alert alert-danger mt-3" id="NostrExtensionError" hidden></div>
    <div class="mt-3" id="NostrUseSignerAppRow" hidden>
        <button type="button" class="btn btn-link" id="NostrUseSignerApp">Use a signer app (QR code) instead</button>
    </div>
    <div class="d-flex align-items-center my-4 text-secondary" id="NostrOrDivider" hidden>
        <hr class="flex-grow-1 my-0" /><span class="mx-3">or use a signer app</span><hr class="flex-grow-1 my-0" />
    </div>
</div>
<noscript><div class="alert alert-warning">JavaScript is required to sign in with Nostr.</div></noscript>
<script>
    (function () {
        var box = document.getElementById("NostrExtension");
        var button = document.getElementById("NostrExtensionButton");
        var errorBox = document.getElementById("NostrExtensionError");
        var useSignerRow = document.getElementById("NostrUseSignerAppRow");
        var divider = document.getElementById("NostrOrDivider");
        var label = button.textContent;

        function qrNeeded() {
            if (window.__nostrQrNeeded) return;
            window.__nostrQrNeeded = true;
            useSignerRow.hidden = true;
            divider.hidden = box.hidden;
            document.dispatchEvent(new Event("nostr-qr-needed"));
        }

        function hasExtension() {
            return window.nostr && typeof window.nostr.signEvent === "function";
        }

        // Extensions inject window.nostr at or after document_end. Decide about the QR after
        // ~0.8 s; keep watching up to ~3 s so a late extension still gets its button.
        var attempts = 0;
        (function detect() {
            if (hasExtension()) {
                box.hidden = false;
                var preparing = document.getElementById("NostrQrPreparing");
                if (preparing) preparing.hidden = true;
                if (window.__nostrQrNeeded) divider.hidden = false;
                else useSignerRow.hidden = false;
                return;
            }
            attempts++;
            if (attempts === 8) qrNeeded();
            if (attempts < 30) setTimeout(detect, 100);
        })();

        document.getElementById("NostrUseSignerApp").addEventListener("click", qrNeeded);

        function fail(message) {
            errorBox.textContent = message;
            errorBox.hidden = false;
            button.disabled = false;
            button.textContent = label;
        }

        button.addEventListener("click", async function () {
            errorBox.hidden = true;
            button.disabled = true;
            button.textContent = "Waiting for your extension\u2026";

            var signed;
            try {
                signed = await window.nostr.signEvent({
                    kind: 27235,
                    created_at: Math.floor(Date.now() / 1000),
                    content: box.dataset.prompt,
                    tags: [["u", box.dataset.authUrl], ["method", "POST"], ["challenge", box.dataset.challenge]]
                });
            } catch (e) {
                return fail("The extension did not sign the request" + (e && e.message ? ": " + e.message : "."));
            }

            var token = box.querySelector('input[name="__RequestVerificationToken"]').value;
            var body = new URLSearchParams();
            body.append("event", JSON.stringify(signed));
            body.append("__RequestVerificationToken", token);
            if (box.dataset.returnUrl) body.append("returnUrl", box.dataset.returnUrl);

            var data;
            try {
                var response = await fetch(box.dataset.authUrl, {
                    method: "POST",
                    body: body,
                    credentials: "same-origin",
                    headers: { "RequestVerificationToken": token }
                });
                data = await response.json();
            } catch (e) {
                return fail("Sign-in request failed. Reload the page and try again.");
            }
            if ((data.status === "approved" || data.status === "2fa_required") && data.redirect) {
                window.location.href = data.redirect;
                return;
            }
            fail(data.error || "Sign-in failed.");
        });
    })();
</script>
